{
  "name": "voip-server",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "shared",
    "server",
    "client",
    "desktop",
    "mobile",
    "admin-console"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "pnpm --filter @voip-server/server dev",
    "dev:client": "pnpm --filter @voip-server/client dev",
    "build": "pnpm --filter @voip-server/client build",
    "start": "pnpm --filter @voip-server/server start",
    "desktop:dev": "pnpm --filter @voip-server/desktop dev",
    "desktop:build": "pnpm --filter @voip-server/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mobile:sync": "pnpm --filter @voip-server/mobile sync",
    "mobile:build": "pnpm --filter @voip-server/mobile build",
    "mobile:apk": "pnpm --filter @voip-server/mobile apk",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo:cleanup": "tsx scripts/seed-demo.ts --cleanup"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "better-sqlite3",
      "mediasoup",
      "esbuild",
      "protobufjs",
      "@firebase/util"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
