# ── SellServ Voice — Production Configuration ───────────────────
# Copy this file to .env and fill in all required values.

# JWT (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Server
PORT=3000
HOST=0.0.0.0
OFFICIAL_INSTANCE=true

# CORS
CORS_ORIGINS=https://chat.sellserv.net

# Instance admins — comma-separated user IDs
ADMIN_USERS=

# ── Database (PostgreSQL) ────────────────────────────────────────
DB_TYPE=postgres
DATABASE_URL=postgres://sellserv:${DB_PASSWORD}@postgres:5432/sellserv
DB_PASSWORD=change-me

# ── Redis / Valkey ───────────────────────────────────────────────
REDIS_URL=redis://valkey:6379

# ── Voice (LiveKit) ─────────────────────────────────────────────
VOICE_TYPE=livekit
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# ── File Storage (S3-compatible / Cloudflare R2) ─────────────────
STORAGE_TYPE=s3
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=sellserv-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://cdn.sellserv.net

# ── File Limits ──────────────────────────────────────────────────
MAX_FILE_SIZE=20971520
MAX_DAILY_UPLOAD_PER_USER=104857600
MAX_TOTAL_DISK=5368709120

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@sellserv.net

# ── Cloudflare Turnstile ────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Push Notifications (Firebase) ────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ── Giphy ────────────────────────────────────────────────────────
GIPHY_API_KEY=

# ── Stripe (Billing) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=https://chat.sellserv.net/settings

# ── OAuth2 (Admin Console) ──────────────────────────────────────
OAUTH2_CLIENT_ID=admin-console
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=https://admin.sellserv.net/auth/callback
