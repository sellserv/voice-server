# Staging Environment
PORT=3001
HOST=127.0.0.1

# JWT (use a DIFFERENT secret than production)
JWT_SECRET=change-me-to-a-random-string

# Instance admins — comma-separated user IDs with full platform control
ADMIN_USERS=

# CORS
CORS_ORIGINS=https://staging.sellserv.net

# Giphy API key (optional)
GIPHY_API_KEY=

# mediasoup (use a different port range than production)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40101
MEDIASOUP_MAX_PORT=40200

# File uploads (separate directory from production)
UPLOAD_DIR=./uploads-staging
MAX_FILE_SIZE=20971520
MAX_DAILY_UPLOAD_PER_USER=104857600
MAX_TOTAL_DISK=5368709120

# Email (Resend) — optional for staging
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Cloudflare Turnstile (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database (separate from production)
DB_PATH=./data/staging.db
