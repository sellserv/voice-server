# ── SellServ Voice ───────────────────────────────────────────────
# Copy this file to .env and fill in the required values.
# For Docker deployment, see deploy/self-hosted/ or deploy/production/

# JWT (REQUIRED — server will not start without this)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32

# Server
PORT=3000
HOST=127.0.0.1

# mediasoup — set ANNOUNCED_IP to your server's public IP
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
# MEDIASOUP_WORKERS=        # Default: number of CPU cores

# CORS — comma-separated list of allowed origins (empty = no CORS)
# CORS_ORIGINS=https://your-domain.com

# Instance admins — comma-separated user IDs with full platform control
# ADMIN_USERS=

# File uploads
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=20971520          # 20MB
# MAX_DAILY_UPLOAD_PER_USER=104857600  # 100MB
# MAX_TOTAL_DISK=5368709120       # 5GB

# Database (SQLite — no configuration needed for most setups)
# DB_PATH=./data/voip-server.db

# Email (optional — email verification disabled without it)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# Cloudflare Turnstile (optional — CAPTCHA disabled without it)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Giphy API key (optional — GIF picker disabled without it)
# GIPHY_API_KEY=

# Push notifications (optional)
# FIREBASE_SERVICE_ACCOUNT=
