# Server
PORT=3000
HOST=127.0.0.1

# JWT (REQUIRED — server will not start without this)
JWT_SECRET=change-me-to-a-random-string

# Instance admins — comma-separated usernames with full platform control
ADMIN_USERS=

# CORS — comma-separated list of allowed origins (empty = no CORS)
CORS_ORIGINS=

# Giphy API key (optional — GIF picker disabled without it)
GIPHY_API_KEY=

# mediasoup
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100
MEDIASOUP_WORKERS=      # Number of mediasoup workers (default: CPU count)

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
MAX_DAILY_UPLOAD_PER_USER=104857600
MAX_TOTAL_DISK=5368709120

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Cloudflare Turnstile (optional — CAPTCHA disabled without it)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database
DB_PATH=./data/voip-server.db
